{
  "name": "@intentguard/execution",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsc -p tsconfig.json && node dist/scripts/smoke-execution.js",
    "smoke:daytona": "tsx scripts/smoke-daytona.ts",
    "smoke:snyk": "tsx scripts/smoke-snyk.ts",
    "smoke:rocketride": "tsx scripts/smoke-rocketride.ts",
    "test": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.json && node dist/scripts/smoke-execution.js"
  },
  "dependencies": {
    "@daytona/sdk": "^0.204.1",
    "@intentguard/contracts": "workspace:*",
    "@intentguard/control": "workspace:*",
    "rocketride": "^1.3.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
