# Every variable here must also exist in the owning package's src/lib/env.ts zod schema.
# Adding a variable means updating this file and that schema in the same commit.
# Never commit .env.local or real credentials.

# Port the control plane listens on.
CONTROL_PORT=4000

# SQLite file used by the real control API. The parent directory is created by
# the server entrypoint. Use :memory: only in tests.
CONTROL_DB_PATH=data/intentguard.db

# Forge export used when the live Forge request is unavailable.
FORGE_RULES_PATH=forge/rules.json

CONTROL_SNAPSHOT_ID=snap-legacy-refunds-4f1c
CONTROL_CORPUS_VERSION=corpus-1
CONTROL_POLICY_VERSION=policy-1
CONTROL_CANDIDATE_IDS=legacy,A,B,C
CONTROL_BLOCKING_SEVERITY=high
WORKER_POLL_MS=250

NODE_ENV=development

# Execution plane: Daytona. All sandboxes in a run use these same limits.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
DAYTONA_CPU=2
DAYTONA_MEMORY_GIB=4
DAYTONA_DISK_GIB=20
DAYTONA_TTL_MINUTES=45
DAYTONA_CREATE_TIMEOUT_SECONDS=180
DAYTONA_COMMAND_TIMEOUT_SECONDS=300
DAYTONA_PREVIEW_TTL_SECONDS=3600

# All targets use one immutable monorepo checkout. The execution adapter maps
# legacy/A/B/C to their fixed packages/fixture source directories internally.
EXECUTION_REPOSITORIES_JSON={"legacy":{"url":"https://github.com/your-org/intentguard.git","commitSha":"0000000000000000000000000000000000000000"},"A":{"url":"https://github.com/your-org/intentguard.git","commitSha":"0000000000000000000000000000000000000000"},"B":{"url":"https://github.com/your-org/intentguard.git","commitSha":"0000000000000000000000000000000000000000"},"C":{"url":"https://github.com/your-org/intentguard.git","commitSha":"0000000000000000000000000000000000000000"}}
EXECUTION_REPOSITORY_DIR=/home/daytona/app
EXECUTION_INSTALL_COMMAND=python3 -m compileall -q .
EXECUTION_APP_PORT=8080
EXECUTION_HEALTH_PATH=/health
EXECUTION_HEALTH_TIMEOUT_SECONDS=120
EXECUTION_HEALTH_POLL_MS=1000
EXECUTION_NETWORK_ALLOWLIST=github.com,*.snyk.io
EXECUTION_GIT_USERNAME=
EXECUTION_GIT_TOKEN=

# Snyk token is injected into only the scan command, never the sandbox environment.
SNYK_TOKEN=
SNYK_CLI_PATH=snyk
SNYK_TIMEOUT_SECONDS=180

# RocketRide narration pipeline. Narration is presentation-only evidence.
ROCKETRIDE_API_KEY=
ROCKETRIDE_URI=https://cloud.rocketride.ai
ROCKETRIDE_PIPELINE_PATH=rocketride/narrate.pipe
ROCKETRIDE_REQUEST_TIMEOUT_MS=30000
ROCKETRIDE_PIPELINE_TTL_SECONDS=60
